        "$type": "boxShadow",
        "$value": {
          "light": "0 24px 64px rgb(40 41 37 / 16%), 0 4px 12px rgb(40 41 37 / 7%)",
          "dark": "0 24px 64px rgb(0 0 0 / 38%), 0 4px 12px rgb(0 0 0 / 24%)"
